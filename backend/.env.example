# Optional: explicit path to TeamClaw config.yaml
# TEAMCLAW_CONFIG_PATH=/absolute/path/to/config.yaml

# Optional: override API host/port
# HOST=0.0.0.0
# PORT=8000

# Optional: backend API language (en | zh)
# TEAMCLAW_LANGUAGE=en

# Optional: override database fields (higher priority than config.yaml database.*)
# TEAMCLAW_DB_HOST=127.0.0.1
# TEAMCLAW_DB_PORT=5432
# TEAMCLAW_DB_USER=teamclaw
# TEAMCLAW_DB_PASSWORD=teamclaw_dev_password
# TEAMCLAW_DB_NAME=teamclaw
# TEAMCLAW_DB_ECHO=false

# Optional: SMTP overrides (higher priority than config.yaml smtp.*)
# TEAMCLAW_SMTP_ENABLED=true
# TEAMCLAW_SMTP_HOST=smtp.example.com
# TEAMCLAW_SMTP_PORT=587
# TEAMCLAW_SMTP_USERNAME=mailer
# TEAMCLAW_SMTP_PASSWORD=secret
# TEAMCLAW_SMTP_FROM_EMAIL=no-reply@example.com
# TEAMCLAW_SMTP_FROM_NAME=TeamClaw
# TEAMCLAW_SMTP_REPLY_TO=support@example.com
# TEAMCLAW_SMTP_USE_TLS=true
# TEAMCLAW_SMTP_USE_SSL=false
# TEAMCLAW_SMTP_TIMEOUT=15
# TEAMCLAW_SMTP_RESET_CODE_TTL_SECONDS=600
# TEAMCLAW_SMTP_RESET_SUBJECT=TeamClaw Password Reset
# TEAMCLAW_SMTP_RESET_URL_TEMPLATE=http://localhost:8080/forgot-password?code={code}&email={email}

# Optional: JWT settings
# TEAMCLAW_JWT_SECRET=change-me
# TEAMCLAW_ACCESS_TOKEN_TTL_SECONDS=7200
# TEAMCLAW_REFRESH_TOKEN_TTL_DAYS=30

# Optional: workspace root for conversations
# TEAMCLAW_WORKSPACES_ROOT=workspaces

# Optional: override LangGraph checkpointer Postgres URL
# Defaults to database config (postgresql://<user>:<pass>@<host>:<port>/<dbname>)
# TEAMCLAW_CHECKPOINTER_URL=postgresql://teamclaw:teamclaw_dev_password@127.0.0.1:5432/teamclaw
